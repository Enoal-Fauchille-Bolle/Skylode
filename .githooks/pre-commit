#!/usr/bin/env sh
# Git pre-commit hook
#
# Runs four checks on all Rust code: cargo fmt, check, clippy and doc. A fifth,
# tarpaulin, ran here until 20bbffa, where it was removed deliberately — this
# header claimed otherwise for months, which is the kind of comment CONTRIBUTING
# now calls worse than none. The coverage gate lives in `ci.yml` instead, where it
# costs a commit nothing and cannot be skipped with a `dev/*` branch name, and the
# argument for the 94 % figure lives in `tarpaulin.toml`, beside the setting it
# defends. The step itself stayed here commented out until it had drifted into
# announcing `[5/5]` among four; git remembers the lines, which is what git is for.
#
# Nothing added by the CI beyond these four belongs here: `cargo-deny`,
# `actionlint` and the MSRV toolchain all need a tool a fresh clone does not have,
# and a hook that fails on a missing tool blocks a correct commit for a reason that
# is not the code.

# Set up colors
RED_BOLD="\033[1;31m"
GREEN_BOLD="\033[1;32m"
BLUE_BOLD="\033[1;34m"
GOLD_BOLD="\033[1;33m"
WHITE_BOLD="\033[1;37m"
RESET="\033[0m"

# Get the current branch name
branch="$(git branch --show-current)"

# If we are on a dev/ branch, bypass all checks
case "$branch" in
  dev/*)
    printf "${GOLD_BOLD}Branch starts with 'dev/', bypassing pre-commit checks.${RESET}\n"
    exit 0
    ;;
esac

printf "${BLUE_BOLD}Running pre-commit checks...${RESET}\n"

# Run cargo fmt
printf "${WHITE_BOLD}[1/4] Running cargo fmt...${RESET}\n"
if ! cargo fmt --all -- --check; then
    printf "${RED_BOLD}cargo fmt failed. Please run 'cargo fmt' to fix formatting issues.${RESET}\n"
    exit 1
fi

# Run cargo check
printf "${WHITE_BOLD}[2/4] Running cargo check...${RESET}\n"
if ! cargo check --all-targets --all-features; then
    printf "${RED_BOLD}cargo check failed. Please fix the compilation errors.${RESET}\n"
    exit 1
fi

# Run cargo clippy
printf "${WHITE_BOLD}[3/4] Running cargo clippy...${RESET}\n"
if ! cargo clippy --all-targets --all-features -- -D warnings; then
    printf "${RED_BOLD}cargo clippy failed. Please fix the linting warnings.${RESET}\n"
    exit 1
fi

# Run cargo doc
# `--no-deps` is correctness, not speed: `-D warnings` would otherwise fail the
# commit over a rustdoc warning inside `rand`, which is not ours to fix. This
# catches an intra-doc link to an item that was renamed or removed; it cannot
# catch rustdoc whose prose has quietly stopped being true.
printf "${WHITE_BOLD}[4/4] Running cargo doc...${RESET}\n"
if ! RUSTDOCFLAGS="-D warnings" cargo doc --workspace --no-deps --document-private-items --all-features; then
    printf "${RED_BOLD}cargo doc failed. Please fix the rustdoc warnings.${RESET}\n"
    exit 1
fi

printf "${GREEN_BOLD}All pre-commit checks passed successfully!${RESET}\n"
exit 0
