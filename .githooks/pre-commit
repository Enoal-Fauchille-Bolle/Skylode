#!/usr/bin/env sh
# Git pre-commit hook
# Runs cargo fmt, check, clippy, doc, and tarpaulin on all Rust code

# Set up colors
RED_BOLD="\033[1;31m"
GREEN_BOLD="\033[1;32m"
BLUE_BOLD="\033[1;34m"
GOLD_BOLD="\033[1;33m"
WHITE_BOLD="\033[1;37m"
RESET="\033[0m"

# Get the current branch name
branch="$(git branch --show-current)"

# If we are on a dev/ branch, bypass all checks
case "$branch" in
  dev/*)
    printf "${GOLD_BOLD}Branch starts with 'dev/', bypassing pre-commit checks.${RESET}\n"
    exit 0
    ;;
esac

printf "${BLUE_BOLD}Running pre-commit checks...${RESET}\n"

# Run cargo fmt
printf "${WHITE_BOLD}[1/5] Running cargo fmt...${RESET}\n"
if ! cargo fmt --all -- --check; then
    printf "${RED_BOLD}cargo fmt failed. Please run 'cargo fmt' to fix formatting issues.${RESET}\n"
    exit 1
fi

# Run cargo check
printf "${WHITE_BOLD}[2/5] Running cargo check...${RESET}\n"
if ! cargo check --all-targets --all-features; then
    printf "${RED_BOLD}cargo check failed. Please fix the compilation errors.${RESET}\n"
    exit 1
fi

# Run cargo clippy
printf "${WHITE_BOLD}[3/5] Running cargo clippy...${RESET}\n"
if ! cargo clippy --all-targets --all-features -- -D warnings; then
    printf "${RED_BOLD}cargo clippy failed. Please fix the linting warnings.${RESET}\n"
    exit 1
fi

# Run cargo doc
# `--no-deps` is correctness, not speed: `-D warnings` would otherwise fail the
# commit over a rustdoc warning inside `rand`, which is not ours to fix. This
# catches an intra-doc link to an item that was renamed or removed; it cannot
# catch rustdoc whose prose has quietly stopped being true.
printf "${WHITE_BOLD}[4/5] Running cargo doc...${RESET}\n"
if ! RUSTDOCFLAGS="-D warnings" cargo doc --workspace --no-deps --document-private-items --all-features; then
    printf "${RED_BOLD}cargo doc failed. Please fix the rustdoc warnings.${RESET}\n"
    exit 1
fi

# Run cargo test & coverage
#
# The backend, the build directory and the skipped clean stage live in
# `tarpaulin.toml`, not here, so that a hand-run `cargo tarpaulin` measures the
# same thing this gate does. Only the gate itself is a hook policy: a manual run
# should report a low figure, not fail on it.
printf "${WHITE_BOLD}[5/5] Running cargo tarpaulin...${RESET}\n"
if ! cargo tarpaulin --fail-under 70 --out Stdout; then
    printf "${RED_BOLD}cargo tarpaulin failed. Please fix the failing tests or improve coverage.${RESET}\n"
    exit 1
fi

printf "${GREEN_BOLD}All pre-commit checks passed successfully!${RESET}\n"
exit 0
